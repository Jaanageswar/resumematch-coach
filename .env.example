# ResumeMatch Coach - example configuration
#
# Copy this file to `.env` and fill in the keys you have.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# `.env` is gitignored and must never be committed. THIS file is committed and
# must never contain a real key.
#
# Every provider is optional. A provider with no key is skipped cleanly, and with
# zero keys the app still runs end-to-end on the local keyword fallback.
#
# Model IDs below were verified live on 2026-10-23. Free-tier catalogs change
# constantly - re-verify any time with:
#     python scripts/check_providers.py --discover

# ---- Provider order (comma-separated; first listed is tried first) ----
# Ordered by measured latency and reliability, not preference. See DESIGN.md s3.
PROVIDER_ORDER=cohere,nvidia,openrouter,huggingface

# ---- Cohere ----       https://dashboard.cohere.com/api-keys
# Fastest and most consistent of the four in testing (~1-3s).
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
COHERE_FALLBACK_MODELS=command-a-03-2025,command-r-08-2024

# ---- NVIDIA NIM ----   https://build.nvidia.com   (keys start with "nvapi-")
# WARNING: GET /v1/models lists ~84 models but most return
# "Function '...': Not found for account" on the free Developer tier, and some
# are hard-410 end-of-life. A catalog listing is not an entitlement - probe first.
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b

# ---- OpenRouter ----   https://openrouter.ai/keys
# Free slugs end in ":free" and rotate weekly. Rate-limits (429) quickly, so it
# sits third in the order rather than first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,thinkingmachines/inkling-small:free

# ---- Hugging Face ----   https://huggingface.co/settings/tokens
# MUST be a FINE-GRAINED token with "Make calls to Inference Providers" ticked.
# A repo-scoped token returns HTTP 403 even though it is otherwise valid.
# Create one here:
#   https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
# It is the only provider with documented json_schema support, so promote it to
# the front of PROVIDER_ORDER once it works.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# ---- Tuning ----
REQUEST_TIMEOUT_SECONDS=45
# 2000, not 600. Reasoning models spend most of their budget on hidden reasoning
# tokens and return HTTP 200 with content=null if too little is left.
MAX_OUTPUT_TOKENS=2000
MAX_INPUT_CHARS=15000
BREAKER_FAILURE_THRESHOLD=2
BREAKER_COOLDOWN_SECONDS=60

# ---- Local-only binding (do not change without reading DESIGN.md s17) ----
# Loopback only. Setting this to 0.0.0.0 would expose the app - and your whole
# analysis history - to every device on your network.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
